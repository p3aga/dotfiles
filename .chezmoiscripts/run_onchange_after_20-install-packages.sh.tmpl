#!/usr/bin/env bash

{{ if eq .chezmoi.osRelease.id "fedora" -}}
set -euo pipefail

# 1. Gerenciar repositórios COPR
echo "==> Gerenciando repositórios COPR..."
{{- if .copr.remove }}
  {{- range .copr.remove }}
echo "Desabilitando COPR: {{ . }}"
sudo dnf copr disable -y {{ . }} || true
  {{- end }}
{{- end }}

{{- if .copr.enable }}
  {{- range .copr.enable }}
echo "Habilitando COPR: {{ . }}"
sudo dnf copr enable -y {{ . }}
  {{- end }}
{{- end }}

# 2. Remover pacotes DNF indesejados
{{- if .dnf.remove }}
echo "==> Removendo pacotes DNF..."
sudo dnf remove -y {{ .dnf.remove | join " " }}
{{- end }}

# 3. Instalar pacotes via DNF
{{- if .dnf.install }}
echo "==> Instalando pacotes via DNF..."
sudo dnf install -y {{.dnf.install | join " " }}
{{- end }}

# 4. Configurar Flathub e instalar Flatpaks
{{- if lookPath "flatpak" }}
echo "==> Configurando Flatpak e instalando aplicativos..."
flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo

{{- if .flatpak.remove }}
  {{- range .flatpak.remove }}
echo "==> Removendo Flatpak {{ . }}"
sudo flatpak remove -y --delete-data {{ . }} || true
  {{- end }}
{{- end }}

{{- if .flatpak.install }}
echo "==> Instalando pacotes Flatpaks..."
sudo flatpak install -y flathub {{ .flatpak.install | join " " }}
{{- end }}
{{- end }}

echo "==> Concluído!"
{{ end -}}